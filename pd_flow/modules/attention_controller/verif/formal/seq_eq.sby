# seq_eq item (SPEC.md section 6): golden vs candidate miter, reset-anchored (ctrl_miter.sv).
# No assumptions anywhere. One task at a time: sby -f seq_eq.sby <task>. seq_lemmas.vh and
# seq_lemmas.ys are generated by formal/lemma_prep.py (empty without lemmas).
#   seq_P         prove, smtbmc z3: basecase BMC to depth 3 from free, independent start states
#                 of both instances, plus k-induction at depth 3 with the lemmas. PASS =
#                 unbounded proof. UNKNOWN = not-proven (fail): add or strengthen lemmas. A
#                 candidate whose registers differ from the golden's needs its own lemmas.
#   sanity_seq_P  negative control: IO0 compared while released (it depends on the non-reset
#                 pos counter, so it differs after the reset), bmc; must FAIL.
[tasks]
seq_8        prove p8
seq_4        prove p4
seq_2        prove p2
sanity_seq_8 sanity p8
sanity_seq_4 sanity p4
sanity_seq_2 sanity p2

[options]
prove: mode prove
prove: depth 3
sanity: mode bmc
sanity: depth 6

[engines]
smtbmc z3

[script]
seq_8:        read_verilog -formal -sv -DP_OUTPUTS=8 ctrl_miter.sv
seq_4:        read_verilog -formal -sv -DP_OUTPUTS=4 ctrl_miter.sv
seq_2:        read_verilog -formal -sv -DP_OUTPUTS=2 ctrl_miter.sv
sanity_seq_8: read_verilog -formal -sv -DP_OUTPUTS=8 -DSANITY_EQ ctrl_miter.sv
sanity_seq_4: read_verilog -formal -sv -DP_OUTPUTS=4 -DSANITY_EQ ctrl_miter.sv
sanity_seq_2: read_verilog -formal -sv -DP_OUTPUTS=2 -DSANITY_EQ ctrl_miter.sv
# golden and candidate are read WITHOUT -formal (FORMAL undefined for them)
read_verilog -sv gold.v
read_verilog -sv ctrl_dut.v
hierarchy -check -top ctrl_miter
proc -norom
# no memories (the exp_lut table stays logic: a ROM is free state under induction)
select -assert-none t:$mem*
# divider review fix F1: no formal cell other than an assertion anywhere
select -assert-none t:$assume t:$live t:$fair t:$cover t:$allconst t:$allseq t:$anyconst t:$anyseq t:$check r:FLAVOR=assert %d
select -assert-none ctrl_miter/t:$assert %n t:$assert %i
# neither instance carries an initial value; only the miter's observers may
select -assert-none a:init ctrl_miter/* %d
flatten
# the golden's control signals for the observers (fixed golden names)
script seq_gold.ys
# candidate lemma nets (gold.* / cand.*); fails if a name is missing
script seq_lemmas.ys
opt_clean
prep -top ctrl_miter
select -assert-none t:$adff* t:$aldff* t:$dffsr* t:$dlatch* t:$adlatch* t:$sr t:$_DFF_N* t:$_DFF_P?_ t:$_DFFE_N* t:$_DFFSR* t:$_ALDFF* t:$_DLATCH* t:$_SR_* t:$_SDFF_N* t:$_SDFFE_N* t:$_SDFFCE_N*
select -assert-none t:$dff r:CLK_POLARITY=1'b0 %i
select -assert-none t:$sdff r:CLK_POLARITY=1'b0 %i

[files]
ctrl_miter.sv
gold.v
ctrl_dut.v
fv_mode.vh
seq_gold.ys
seq_lemmas.vh
seq_lemmas.ys
