# Agent 3 (divider): bridge B (golden + observers) vs C' (candidate + observers) at LATCH_DENOMINATOR=0,
# CHECK_INVALID=0, both in the identical harness eqtop_obs.v (power-on reset in cycle 0). Only harness
# ports matched, all in one partition. INDUCTION part: Yosys SAT k-induction, depth 2 (X-aware; the
# hypothesis includes the observer invariants). Its base case starts from all-undef flops and is not
# relied on: the base case is checked by eqy_base_P*.eqy (SBY smtbmc, xprop on, real initial state).
[gold]
read_verilog -sv gold.v
read_verilog -sv eqtop_obs.v
chparam -set LD 0 -set CI 0 eqtop
prep -top eqtop
flatten
opt_clean

[gate]
read_verilog -sv gate.v
read_verilog -sv eqtop_obs.v
chparam -set LD 0 -set CI 0 eqtop
prep -top eqtop
flatten
opt_clean

[match *]
gold-nomatch u.*
gate-nomatch u.*
gold-nomatch boot
gate-nomatch boot
gold-nomatch busy
gate-nomatch busy
gold-nomatch done
gate-nomatch done
gold-nomatch result
gate-nomatch result
gold-nomatch lg
gate-nomatch lg
gold-nomatch lc
gate-nomatch lc
gold-nomatch ph
gate-nomatch ph
gold-nomatch dq
gate-nomatch dq
gold-nomatch rm
gate-nomatch rm
gold-nomatch dv
gate-nomatch dv
gold-nomatch ng
gate-nomatch ng
gold-nomatch iv
gate-nomatch iv
gold-nomatch sn
gate-nomatch sn

[collect *]
group *_o

[strategy sat]
use sat
depth 2
