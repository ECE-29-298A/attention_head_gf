# seq_eq item (SPEC.md section 4, amendment A-1): golden vs candidate miter, anchored on the
# cycle-0 reset (structural, in divider_miter.sv). No assumptions anywhere.
# Run one task at a time: sby -f seq_eq.sby <task>. The lemma include seq_lemmas.vh and the
# connect script seq_lemmas.ys are generated by formal/lemma_prep.py (empty without lemmas).
#   seq_00 / seq_11      prove, smtbmc z3: basecase BMC to depth 30 from the cycle-0 reset
#                        (more than one 25-edge division, so a mismatch at a first completion
#                        is a counterexample with a trace), plus k-induction (depth 30) with
#                        the lemmas. PASS = unbounded proof. UNKNOWN (induction did not
#                        close, e.g. no or too weak lemmas) = not-proven = fail.
#                        (abc pdr was tried as a second engine: it finds counterexamples but
#                        SBY cannot replay its traces here (ERROR), and without lemmas it did
#                        not prove even golden-vs-golden within 3 minutes; not used.)
#   sanity_seq_00/11     negative control: a wrong equality (result off by one), bmc.
[tasks]
seq_00        prove p00
seq_11        prove p11
sanity_seq_00 sanity p00
sanity_seq_11 sanity p11

[options]
prove: mode prove
prove: depth 30
sanity: mode bmc
sanity: depth 3

[engines]
prove: smtbmc z3
sanity: smtbmc z3

[script]
seq_00:        read_verilog -formal -sv divider_miter.sv
seq_11:        read_verilog -formal -sv -DP11 divider_miter.sv
sanity_seq_00: read_verilog -formal -sv -DSANITY_EQ divider_miter.sv
sanity_seq_11: read_verilog -formal -sv -DSANITY_EQ -DP11 divider_miter.sv
read_verilog -formal gold.v
read_verilog -formal divider_fv.v
hierarchy -top divider_miter
proc
# review fix F1 (agent 2): no formal cell other than an assertion anywhere (a candidate-side
# assume, e.g. under `ifdef FORMAL, would constrain the shared inputs of the miter).
select -assert-none t:$assume t:$live t:$fair t:$cover t:$allconst t:$allseq t:$check r:FLAVOR=assert %d
# guard: neither instance carries an initial value; only the miter's observers may.
select -assert-none a:init divider_miter/* %d
flatten
# lemma nets (gold.* / cand.*) connected to harness wires; fails if a name is missing
script seq_lemmas.ys
opt_clean
prep -top divider_miter
select -assert-none t:$adff* t:$aldff* t:$dffsr* t:$dlatch* t:$adlatch* t:$sr t:$mem* t:$_DFF_N* t:$_DFF_P?_ t:$_DFFE_N* t:$_DFFSR* t:$_ALDFF* t:$_DLATCH* t:$_SR_* t:$_SDFF_N* t:$_SDFFE_N* t:$_SDFFCE_N*
select -assert-none t:$dff r:CLK_POLARITY=1'b0 %i
select -assert-none t:$dffe r:CLK_POLARITY=1'b0 %i
select -assert-none t:$sdff r:CLK_POLARITY=1'b0 %i
select -assert-none t:$sdffe r:CLK_POLARITY=1'b0 %i
select -assert-none t:$sdffce r:CLK_POLARITY=1'b0 %i

[files]
divider_miter.sv
gold.v
divider_fv.v
fv_mode.vh
seq_lemmas.vh
seq_lemmas.ys
