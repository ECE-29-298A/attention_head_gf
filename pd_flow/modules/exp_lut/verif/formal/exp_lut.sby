# SymbiYosys contract for exp_lut. Run one task at a time: sby -f exp_lut.sby <task>
# exp_lut_fv.v is the DUT as Yosys reads it (RTL: the RTL file; gate level: the Yosys view
# from gate/extract_cells.py). ref_table.vh is generated by model/golden_model.py vhdr;
# fv_mode.vh by run_all.sh (defines GATE for a netlist). No assumptions anywhere; the DUT
# has no initial value.
# *_r0: REGISTERED = 0 (combinational). equiv_r0 / pdr_equiv_r0 prove W == f(D, shift) and
#   done == start for every input; there is no state, so this is a complete combinational
#   equivalence (smtbmc/Z3 and, independently, abc pdr).
# *_r1: REGISTERED = 1. prove_r1: k-induction (smtbmc/Z3); pdr_r1: abc pdr (IC3).
# sanity_*: negative controls, must be refuted (bmc).
[tasks]
equiv_r0        prove z3 r0
pdr_equiv_r0    prove pdr r0
cover_r0        cover0 r0
sanity_trunc_r0 sanity r0
sanity_d21_r0   sanity r0
prove_r1        prove z3 r1
pdr_r1          prove pdr r1
cover_r1        cover1 r1
sanity_pu_r1    sanity r1
sanity_lat0_r1  sanity r1

[options]
prove: mode prove
prove: depth 4
cover0: mode cover
cover0: depth 1
cover1: mode cover
cover1: depth 10
sanity: mode bmc
sanity: depth 4

[engines]
z3: smtbmc z3
pdr: abc pdr
cover0: smtbmc z3
cover1: smtbmc z3
sanity: smtbmc z3

[script]
equiv_r0:        read_verilog -formal -sv -DR0 exp_lut_props.sv
pdr_equiv_r0:    read_verilog -formal -sv -DR0 exp_lut_props.sv
cover_r0:        read_verilog -formal -sv -DR0 -DCOVERS exp_lut_props.sv
sanity_trunc_r0: read_verilog -formal -sv -DR0 -DSANITY_TRUNC exp_lut_props.sv
sanity_d21_r0:   read_verilog -formal -sv -DR0 -DSANITY_D21 exp_lut_props.sv
prove_r1:        read_verilog -formal -sv -DR1 exp_lut_props.sv
pdr_r1:          read_verilog -formal -sv -DR1 exp_lut_props.sv
cover_r1:        read_verilog -formal -sv -DR1 -DCOVERS exp_lut_props.sv
sanity_pu_r1:    read_verilog -formal -sv -DR1 -DSANITY_PU exp_lut_props.sv
sanity_lat0_r1:  read_verilog -formal -sv -DR1 -DSANITY_LAT0 exp_lut_props.sv
read_verilog -formal exp_lut_fv.v
hierarchy -top exp_lut_props
proc -norom
# (proc -norom: case tables stay logic, not ROM cells, so the $mem guard below stays strict.)
# guard: the DUT carries no initial value (power-up state unconstrained); only the
# harness's own observer registers may have one. Runs after proc (which turns `initial`
# blocks into init attributes) and before flatten (afterwards every wire lives in
# exp_lut_props). Lesson from max_reg review N1.
select -assert-none a:init exp_lut_props/* %d
# flatten + opt_clean collapse non-inverting buffers (e.g. a CTS clkbuf from clk to the flops),
# so "clocked by clk" means the same here as in the lint structure check (SPEC R14). An
# inverting or gated clock stays a derived clock, which SBY refuses (inconclusive).
flatten
opt_clean
prep -top exp_lut_props
# guard: one positive-edge clock, synchronous logic only: no asynchronous reset/set, no
# latches, memories or negative-edge flops. (Without multiclock, SBY treats every flop as
# clocked by the global step; lint also checks this.) Synchronous-reset flops ($sdff*) are
# allowed: REGISTERED = 1 has a synchronous reset.
select -assert-none t:$adff* t:$aldff* t:$dffsr* t:$dlatch* t:$adlatch* t:$sr t:$mem* t:$_DFF_N* t:$_DFF_P?_ t:$_DFFE_N* t:$_DFFSR* t:$_ALDFF* t:$_DLATCH* t:$_SR_* t:$_SDFF_N* t:$_SDFFE_N* t:$_SDFFCE_N*
select -assert-none t:$dff r:CLK_POLARITY=1'b0 %i
select -assert-none t:$dffe r:CLK_POLARITY=1'b0 %i
select -assert-none t:$sdff r:CLK_POLARITY=1'b0 %i
select -assert-none t:$sdffe r:CLK_POLARITY=1'b0 %i
select -assert-none t:$sdffce r:CLK_POLARITY=1'b0 %i

[files]
exp_lut_fv.v
exp_lut_props.sv
ref_table.vh
fv_mode.vh
