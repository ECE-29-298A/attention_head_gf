# Gate mode item eqy_rtl: the netlist (Yosys view max_reg_fv.v: netlist + combinational PDK
# models + liberty flop models) against the golden RTL. Strategy sat, depth 1: with the
# state matched by name (the 22 flops behind M), each partition's next-state and output
# functions are proven equal by SAT, which is an unbounded equivalence proof. A netlist that
# re-encodes the state so that no match exists gives "equivalence unknown" (failed), and would
# need its own reviewed match.
[gold]
read_verilog -sv gold.v
prep -top max_reg

[gate]
read_verilog gate.v
hierarchy -top max_reg
proc; flatten; opt_clean
prep -top max_reg

[strategy sat]
use sat
depth 1
