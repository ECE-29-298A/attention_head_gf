# Agent 2: sequential equivalence golden max_reg vs mutant (EQY, SAT on matched M flops).
# Both designs have the same 22 state bits (M); EQY matches them by name, so equivalence of
# the next-state functions for every (M, S_in, en, first) is an unbounded proof.
[gold]
read_verilog -sv gold.v
prep -top max_reg

[gate]
read_verilog -sv gate.v
prep -top max_reg

[strategy sat]
use sat
depth 1
