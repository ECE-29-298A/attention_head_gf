# seq_eq item (SPEC.md section 5): golden vs candidate miter, flush-anchored (mac_miter.sv).
# No assumptions anywhere. Run one task at a time: sby -f seq_eq.sby <task>. The lemma
# include seq_lemmas.vh and the connect script seq_lemmas.ys are generated by
# formal/lemma_prep.py (empty without lemmas).
#   seq_P         prove, smtbmc z3: basecase BMC to depth P+3 from free, independent start
#                 states of both instances, plus k-induction at depth P+3 with the lemmas.
#                 P+3 edges let every ring slot pass the head at least once inside the trace,
#                 so for a candidate whose state is visible at its ports within P edges the
#                 induction closes without lemmas. PASS = unbounded proof. UNKNOWN = not-proven
#                 (fail): add or strengthen lemmas.
#   sanity_seq_P  negative control: a wrong equality (S off by one), bmc.
[tasks]
seq_8        prove p8
seq_4        prove p4
seq_2        prove p2
sanity_seq_8 sanity p8
sanity_seq_4 sanity p4
sanity_seq_2 sanity p2

[options]
prove: mode prove
sanity: mode bmc
p8: depth 11
p4: depth 7
p2: depth 5

[engines]
smtbmc z3

[script]
seq_8:        read_verilog -formal -sv -DP_OUTPUTS=8 -DP_SELW=3 mac_miter.sv
seq_4:        read_verilog -formal -sv -DP_OUTPUTS=4 -DP_SELW=2 mac_miter.sv
seq_2:        read_verilog -formal -sv -DP_OUTPUTS=2 -DP_SELW=1 mac_miter.sv
sanity_seq_8: read_verilog -formal -sv -DP_OUTPUTS=8 -DP_SELW=3 -DSANITY_EQ mac_miter.sv
sanity_seq_4: read_verilog -formal -sv -DP_OUTPUTS=4 -DP_SELW=2 -DSANITY_EQ mac_miter.sv
sanity_seq_2: read_verilog -formal -sv -DP_OUTPUTS=2 -DP_SELW=1 -DSANITY_EQ mac_miter.sv
# golden and candidate are read WITHOUT -formal (FORMAL undefined for them)
read_verilog -sv gold.v
read_verilog -sv mac_unit_fv.v
hierarchy -top mac_miter
proc
# divider review fix F1: no formal cell other than an assertion anywhere (a candidate-side
# assume would constrain the shared inputs of the miter).
select -assert-none t:$assume t:$live t:$fair t:$cover t:$allconst t:$allseq t:$anyconst t:$anyseq t:$check r:FLAVOR=assert %d
select -assert-none mac_gold/t:$assert mac_unit/t:$assert
# guard: neither instance carries an initial value; only the miter's observers may.
select -assert-none a:init mac_miter/* %d
flatten
# lemma nets (gold.* / cand.*) connected to harness wires; fails if a name is missing
script seq_lemmas.ys
opt_clean
prep -top mac_miter
select -assert-none t:$adff* t:$aldff* t:$dffsr* t:$dlatch* t:$adlatch* t:$sr t:$mem* t:$_DFF_N* t:$_DFF_P?_ t:$_DFFE_N* t:$_DFFSR* t:$_ALDFF* t:$_DLATCH* t:$_SR_* t:$_SDFF_N* t:$_SDFFE_N* t:$_SDFFCE_N*
select -assert-none t:$dff r:CLK_POLARITY=1'b0 %i
select -assert-none t:$dffe r:CLK_POLARITY=1'b0 %i
select -assert-none t:$sdff r:CLK_POLARITY=1'b0 %i
select -assert-none t:$sdffe r:CLK_POLARITY=1'b0 %i
select -assert-none t:$sdffce r:CLK_POLARITY=1'b0 %i

[files]
mac_miter.sv
gold.v
mac_unit_fv.v
fv_mode.vh
seq_lemmas.vh
seq_lemmas.ys
